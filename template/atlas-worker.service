# systemd --user unit. Copie para ~/.config/systemd/user/atlas-worker.service, ajuste os caminhos,
# depois: systemctl --user daemon-reload && systemctl --user enable --now atlas-worker
[Unit]
Description=Atlas worker (LLM requests and filesystem sync)
After=network-online.target docker.service

[Service]
WorkingDirectory=/path/to/your-atlas
ExecStart=/usr/bin/node /path/to/your-atlas/scripts/worker.mjs
Restart=always
RestartSec=15
Environment=PATH=%h/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
